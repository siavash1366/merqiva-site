{
  "name": "Merqiva — Website Lead → Telegram Alert (Production Template)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "merqiva-sales-alert",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-lead",
      "name": "Merqiva Sales Alert",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-560, 0],
      "webhookId": "merqiva-sales-alert"
    },
    {
      "parameters": {
        "jsCode": "const body=$json.body??$json;\nconst clean=(v,max=1000)=>String(v??'').trim().slice(0,max);\nreturn [{json:{\n  leadId:clean(body.id||body.leadId,120),\n  name:clean(body.name,120),\n  company:clean(body.company,180),\n  email:clean(body.email,220),\n  country:clean(body.country,120),\n  offering:clean(body.offering||body.product||body.role,300),\n  market:clean(body.market||body.targetMarket,180),\n  source:clean(body.source||'website',120),\n  message:clean(body.message,1800),\n  createdAt:clean(body.createdAt||new Date().toISOString(),80)\n}}];"
      },
      "id": "normalize-lead",
      "name": "Normalize Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-300, 0]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "RESELECT_OR_SET_CHAT_ID_AFTER_IMPORT",
        "text": "={{ '🚢 NEW MERQIVA LEAD\\n\\n' + 'Lead ID: ' + ($json.leadId || '—') + '\\n' + 'Name: ' + ($json.name || '—') + '\\n' + 'Company: ' + ($json.company || '—') + '\\n' + 'Email: ' + ($json.email || '—') + '\\n' + 'Country: ' + ($json.country || '—') + '\\n' + 'Offering: ' + ($json.offering || '—') + '\\n' + 'Target market: ' + ($json.market || '—') + '\\n' + 'Source: ' + ($json.source || '—') + '\\n\\n' + 'Message: ' + ($json.message || '—') + '\\n\\n' + 'Received: ' + ($json.createdAt || '') }}",
        "additionalFields": {}
      },
      "id": "telegram-alert",
      "name": "Send Lead Alert to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [-40, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\":true,\"delivered\":\"telegram\"}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-success",
      "name": "Acknowledge Alert",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [220, 0]
    }
  ],
  "connections": {
    "Merqiva Sales Alert": {
      "main": [[{"node":"Normalize Lead","type":"main","index":0}]]
    },
    "Normalize Lead": {
      "main": [[{"node":"Send Lead Alert to Telegram","type":"main","index":0}]]
    },
    "Send Lead Alert to Telegram": {
      "main": [[{"node":"Acknowledge Alert","type":"main","index":0}]]
    }
  },
  "pinData": {},
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "merqiva-sales-alert-production-template-v2",
  "meta": {
    "templateCredsSetupCompleted": false,
    "notes": "After import, select a Header Auth credential on the Webhook, select the Telegram credential, and set the target Chat ID. Secrets are intentionally not stored in this repository."
  },
  "tags": []
}